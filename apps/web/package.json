{
  "name": "@mdplane/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbo",
    "build": "node ./scripts/clean-next.mjs && next build",
    "start": "next start",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run test:unit",
    "test:unit": "bun test ./src",
    "test:e2e": "playwright test",
    "test:e2e:dev": "playwright test -c playwright.dev.config.ts",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@fontsource/monaspace-neon": "^5.2.5",
    "@mdplane/shared": "workspace:^",
    "@mdplane/ui": "workspace:*",
    "@tanstack/react-query": "^5.100.14",
    "better-auth": "^1.6.11",
    "clsx": "^2.1.1",
    "lucide-react": "^0.563.0",
    "mermaid": "^11.15.0",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "nuqs": "^2.8.9",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0",
    "rehype-mermaid": "^3.0.0",
    "rehype-mermaidjs": "^2.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "scroll-into-view-if-needed": "^3.1.0",
    "shiki": "^3.23.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@eslint/eslintrc": "^3.3.5",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^20.19.41",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.1.6",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.3"
  }
}
