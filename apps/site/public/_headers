# Fingerprinted files never change, so browsers keep them for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Nothing loads from another origin, nothing may frame a page, and only lit-html may turn strings
# into HTML. The Worker sends the same policy with the pages it serves itself.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; require-trusted-types-for 'script'; trusted-types lit-html
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
