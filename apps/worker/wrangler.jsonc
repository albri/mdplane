{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mdplane",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-28",
  // node:crypto gives a synchronous SHA-256, so sealing an entry never awaits.
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  // The site and the reader are static files built by apps/site. Anything that isn't one of
  // them reaches the Worker. So does the root, which answers agents with markdown and browsers
  // with the landing page.
  "assets": {
    "directory": "../site/dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    "run_worker_first": ["/"],
  },
  "build": {
    "command": "pnpm --filter @mdplane/site build",
    "watch_dir": "../site/src",
  },
  // The preview has no public URL. It shares the account with mdplane.dev, and workers.dev is
  // outside the zone's rate-limiting rule. `--env open` below turns it on for a test.
  "workers_dev": false,
  "preview_urls": false,
  // An invocation log records each request's full URL, and the URL holds the link's key, so
  // those logs are off and only what the Worker logs itself is kept. Traces record the URL too:
  // never turn them on.
  "observability": { "enabled": true, "logs": { "invocation_logs": false } },
  "durable_objects": {
    "bindings": [
      { "name": "WORKSPACES", "class_name": "Workspace" },
      // Counts the workspaces made each day, so there is a ceiling on what they can cost.
      { "name": "QUOTA", "class_name": "Quota" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Workspace"] },
    { "tag": "v2", "new_sqlite_classes": ["Quota"] },
  ],
  // Each limit counts per Cloudflare location, so none of them is exact.
  "ratelimits": [
    // Per address, IPv6 by its /64.
    { "name": "CREATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    // Per link. A made-up secret starts a fresh count, which is why there is a limit per address
    // as well.
    { "name": "LINK_LIMITER", "namespace_id": "1002", "simple": { "limit": 300, "period": 60 } },
    // Per address, IPv6 by its /64, across every request with a key in it.
    { "name": "ADDRESS_LIMITER", "namespace_id": "1003", "simple": { "limit": 600, "period": 60 } },
  ],
  "vars": {
    // 0 keeps workspaces until they are deleted.
    "WORKSPACE_TTL_HOURS": "72",
    "LEASE_SECONDS": "600",
    // The text a workspace may hold: every entry's body and every distinct version of a file
    // body. 0 means no limit.
    "WORKSPACE_MAX_BYTES": "8388608",
    // Anything but "true" stops new workspaces from being made. Existing links keep working.
    "CREATE_ENABLED": "true",
    // New workspaces a day across the service, counted in UTC. 0 means no limit.
    "CREATE_DAILY_LIMIT": "100",
  },
  // mdplane.dev, as the Worker "mdplane-production". Only CI deploys it, from main, after a
  // reviewer approves the GitHub production environment. A plain `wrangler deploy` makes the
  // Worker above, which is the preview and what a self-hoster gets.
  "env": {
    // The preview on workers.dev, for a test session: the same Worker as above, so the next plain
    // `wrangler deploy` sets its URL back to what the top level says. An environment inherits no
    // bindings or vars, so these repeat the ones above, namespaces and all.
    "open": {
      "name": "mdplane",
      "workers_dev": true,
      // Each version's own URL would be another way in, and a test needs only the one.
      "preview_urls": false,
      "durable_objects": {
        "bindings": [
          { "name": "WORKSPACES", "class_name": "Workspace" },
          { "name": "QUOTA", "class_name": "Quota" },
        ],
      },
      "ratelimits": [
        {
          "name": "CREATE_LIMITER",
          "namespace_id": "1001",
          "simple": { "limit": 10, "period": 60 },
        },
        {
          "name": "LINK_LIMITER",
          "namespace_id": "1002",
          "simple": { "limit": 300, "period": 60 },
        },
        {
          "name": "ADDRESS_LIMITER",
          "namespace_id": "1003",
          "simple": { "limit": 600, "period": 60 },
        },
      ],
      "vars": {
        "WORKSPACE_TTL_HOURS": "72",
        "LEASE_SECONDS": "600",
        "WORKSPACE_MAX_BYTES": "8388608",
        "CREATE_ENABLED": "true",
        "CREATE_DAILY_LIMIT": "100",
      },
    },
    "production": {
      // A route, not a custom domain, so the zone's DNS record stays as it was. Removing the route
      // hands mdplane.dev back to that record at once. A custom domain would replace the record,
      // and wrangler does that without asking when it runs in CI.
      "routes": [{ "pattern": "mdplane.dev/*", "zone_name": "mdplane.dev" }],
      // Every request comes through the zone, where the rate-limiting rule applies and NEL is
      // off. workers.dev would be a way round both.
      "workers_dev": false,
      "preview_urls": false,
      // Workers Paid bills CPU time and allows 30 seconds of it a request by default. This stops a
      // runaway request after 1 second. The heaviest requests measured on the preview use under
      // 20 ms. The margin is for a workspace at its limits, whose object's CPU is unmeasured.
      "limits": { "cpu_ms": 1000 },
      // An environment inherits no bindings or vars, so these repeat the ones above. The limiters
      // have their own namespaces, so the preview's traffic doesn't count against mdplane.dev.
      "durable_objects": {
        "bindings": [
          { "name": "WORKSPACES", "class_name": "Workspace" },
          { "name": "QUOTA", "class_name": "Quota" },
        ],
      },
      "ratelimits": [
        {
          "name": "CREATE_LIMITER",
          "namespace_id": "2001",
          "simple": { "limit": 10, "period": 60 },
        },
        {
          "name": "LINK_LIMITER",
          "namespace_id": "2002",
          "simple": { "limit": 300, "period": 60 },
        },
        {
          "name": "ADDRESS_LIMITER",
          "namespace_id": "2003",
          "simple": { "limit": 600, "period": 60 },
        },
      ],
      "vars": {
        "WORKSPACE_TTL_HOURS": "72",
        "LEASE_SECONDS": "600",
        "WORKSPACE_MAX_BYTES": "8388608",
        "CREATE_ENABLED": "true",
        "CREATE_DAILY_LIMIT": "100",
      },
    },
  },
}
