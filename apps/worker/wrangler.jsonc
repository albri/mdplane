{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mdplane",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-28",
  // node:crypto gives a synchronous SHA-256, so sealing an entry never awaits.
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  // The site and the reader are static files built by apps/site. Anything that isn't one of
  // them reaches the Worker.
  "assets": {
    "directory": "../site/dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
  },
  "build": {
    "command": "pnpm --filter @mdplane/site build",
    "watch_dir": "../site/src",
  },
  // An invocation log records each request's full URL, and the URL holds the link's key, so
  // those logs are off and only what the Worker logs itself is kept. Traces record the URL too:
  // never turn them on.
  "observability": { "enabled": true, "logs": { "invocation_logs": false } },
  "durable_objects": {
    "bindings": [{ "name": "WORKSPACES", "class_name": "Workspace" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Workspace"] }],
  "ratelimits": [
    { "name": "CREATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "LINK_LIMITER", "namespace_id": "1002", "simple": { "limit": 300, "period": 60 } },
  ],
  "vars": {
    "WORKSPACE_TTL_HOURS": "24",
    "LEASE_SECONDS": "600",
  },
}
