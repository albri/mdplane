{
  "name": "mdplane",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "pnpm -r generate",
    "check": "oxlint --type-aware --deny-warnings && oxfmt --check && tsc -p packages/contract && tsc -p apps/worker && tsc -p apps/site && tsc -p video && pnpm -r check",
    "test": "pnpm -r test",
    "format": "oxfmt",
    "build": "pnpm --filter @mdplane/site build",
    "e2e": "pnpm --filter @mdplane/site e2e"
  },
  "devDependencies": {
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@9.15.0",
  "pnpm": {
    "overrides": {
      "js-yaml@>=4.0.0 <4.3.2": "^4.3.2",
      "zod@>=4.0.0 <4.6.6": "^4.6.7"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  }
}
